<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>true</IsPackable>
    <PackageId>{{ASSEMBLY_NAME}}</PackageId>
    <Version>0.1.0-beta</Version>
    <Description>{{DESCRIPTION}}</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpClaw.Contracts" Version="[0.5.0-beta.36]" />
    <PackageReference Include="SharpClaw.ModuleSDK" Version="[0.5.0-beta.16]" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="module.json" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

</Project>
