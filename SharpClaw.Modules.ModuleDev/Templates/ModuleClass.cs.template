using System.Text.Json;
using Microsoft.Extensions.DependencyInjection;
using SharpClaw.Contracts.Modules;

namespace {{NAMESPACE}};

public sealed class {{CLASS_NAME}} : ISharpClawModule
{
    public ModuleIdentity Identity { get; } = new(
        "{{MODULE_ID}}",
        "{{DISPLAY_NAME}}",
        "{{TOOL_PREFIX}}");

    public void Configure(ISharpClawModuleBuilder module)
    {
        module.Services.AddSingleton<GeneratedToolHandler>();
        foreach (var descriptor in GeneratedToolHandler.Descriptors)
            module.Tools.Add<GeneratedToolHandler>(descriptor);
    }
}

public sealed class GeneratedToolHandler : IToolHandler
