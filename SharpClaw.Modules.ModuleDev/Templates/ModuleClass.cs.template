    public ValueTask<ToolResult> InvokeAsync(
        ToolInvocation invocation,
        CancellationToken ct) =>
        invocation.ToolName switch
        {
{{TOOL_DISPATCH}}
            _ => throw new NotSupportedException($"Unknown Tool: {invocation.ToolName}"),
        };
}
